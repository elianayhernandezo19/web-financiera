# =============================================================================
# .dockerignore
#
# Excludes files that should never reach the build context sent to Docker.
# Benefits:
#   • Faster builds (less data transferred to the daemon)
#   • Smaller attack surface (no secrets, git history, or dev tooling)
#   • Avoids accidentally overwriting node_modules with the host copy
# =============================================================================

# ── Dependencies & build output (rebuilt inside the container) ────────────────
node_modules/
dist/
.angular/

# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── CI/CD ─────────────────────────────────────────────────────────────────────
.github/
.circleci/
.gitlab-ci.yml

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.iml

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
karma.conf.js

# ── Docker files (avoid recursive nesting) ────────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── Documentation ─────────────────────────────────────────────────────────────
*.md
!README.md
